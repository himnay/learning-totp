{
  "_type": "export",
  "__export_format": 4,
  "__export_date": "2026-09-02T00:00:00.000Z",
  "__export_source": "learning-totp.manual",
  "resources": [
    {
      "_id": "wrk_learning_totp",
      "_type": "workspace",
      "parentId": null,
      "name": "learning-totp",
      "description": "register/generate/validate TOTP + recovery code demo APIs built on totp-spring-boot-starter"
    },
    {
      "_id": "env_base",
      "_type": "environment",
      "parentId": "wrk_learning_totp",
      "name": "Base Environment",
      "data": {
        "baseUrl": "http://localhost:8096"
      }
    },
    {
      "_id": "req_totp_register",
      "_type": "request",
      "parentId": "wrk_learning_totp",
      "name": "Register App (generate/rotate secret)",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/totp/register",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"appId\": \"alice-iphone-15-authenticator-v2\",\n  \"issuer\": \"learning-totp\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "_id": "req_totp_generate_qr",
      "_type": "request",
      "parentId": "wrk_learning_totp",
      "name": "Generate QR Code",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/totp/generate-qr",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"appId\": \"alice-iphone-15-authenticator-v2\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "_id": "req_totp_generate",
      "_type": "request",
      "parentId": "wrk_learning_totp",
      "name": "Generate Current Code",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/totp/generate-code",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"appId\": \"alice-iphone-15-authenticator-v2\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "_id": "req_totp_validate_qr",
      "_type": "request",
      "parentId": "wrk_learning_totp",
      "name": "Validate Code (QR-enrolled)",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/totp/validate-qr",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"appId\": \"alice-iphone-15-authenticator-v2\",\n  \"code\": \"123456\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "_id": "req_totp_validate",
      "_type": "request",
      "parentId": "wrk_learning_totp",
      "name": "Validate Code",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/totp/validate-code",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"appId\": \"alice-iphone-15-authenticator-v2\",\n  \"code\": \"123456\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "_id": "req_recovery_generate",
      "_type": "request",
      "parentId": "wrk_learning_totp",
      "name": "Generate Recovery Codes",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/totp/recovery-codes/generate",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"appId\": \"alice-iphone-15-authenticator-v2\",\n  \"count\": 10\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "_id": "req_recovery_validate",
      "_type": "request",
      "parentId": "wrk_learning_totp",
      "name": "Validate (Redeem) Recovery Code",
      "method": "POST",
      "url": "{{ _.baseUrl }}/api/v1/totp/recovery-codes/validate",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"appId\": \"alice-iphone-15-authenticator-v2\",\n  \"code\": \"tf8i-exmo-3lcb-slkm\"\n}"
      },
      "headers": [
        { "name": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
